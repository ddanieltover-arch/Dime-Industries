# .env.example
# Copy to .env.local for development. Never commit the real .env.local.
#
# Variables are grouped by whether code actually reads them yet — checked
# by grepping the codebase, not assumed from the architecture docs. Adding a
# variable here that nothing reads yet would be misleading; adding one here
# without a code reference is a sign either the docs are ahead of the code
# (fine, noted below) or someone forgot to wire it up (not fine).

# =============================================================================
# LIVE — referenced by shipped code (Backend Phase 1, db/seed.ts)
# =============================================================================

# Supabase project URL and anon (public) key. Safe to expose to the browser
# — RLS is what actually protects data, not secrecy of these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — bypasses RLS entirely. Server-only, NEVER prefix with
# NEXT_PUBLIC_, never log it, never send it to Sentry (see
# sentry.server.config.ts's beforeSend scrubbing).
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, used by db/seed.ts and the migration
# steps in deploy-staging.yml / deploy-production.yml. Use the pooled
# (PgBouncer) connection string for the app itself once it needs one; this
# unpooled one is for migrations/seeding only, per Database Architecture §5.
DATABASE_URL=

# =============================================================================
# CONFIGURED BUT NOT YET READ BY APP CODE — this DevOps phase wires the
# deployment/monitoring plumbing for these; the app code that uses them
# ships in later phases (Integrations, Checkout). Set these now so staging/
# production environments are ready when that code lands — an empty value
# here won't break anything currently deployed.
# =============================================================================

# Sentry (Error Reporting / Monitoring) — read by sentry.*.config.ts and
# next.config.js, which DO ship in this phase.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Resend (transactional email) — read by lib/email/resend.ts
RESEND_API_KEY=
RESEND_FROM=DIME Industries <sales@dimeindustries.us>
# Admin inbox for order/contact/wholesale/newsletter alerts (default: sales@…)
ADMIN_EMAIL=sales@dimeindustries.us

# Paybis (payment gateway) — read by lib/payments/paybis.ts
# Leave empty to use mock checkout (/checkout/mock-pay/...).
PAYBIS_API_KEY=
PAYBIS_API_SECRET=
PAYBIS_WEBHOOK_SECRET=
PAYBIS_API_BASE=
PAYBIS_WIDGET_BASE=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Orders persistence: auto (DB if DATABASE_URL set), database, or cookie
ORDERS_PERSISTENCE=auto

# COA / Rewards / Assistant — defaults to public DIME reference hosts when unset.
# Set to "off" to force mock/local. Override BASE to point at another host.
# COA: https://coas-7d1e18b1a038.herokuapp.com  (GET /api/coas?q=)
# Assistant: https://budtender-bdf452c7c488.herokuapp.com  (POST /chat → { reply })
# Rewards REST: leave empty — rewards.dimeindustries.com is an OAuth SPA (use REWARDS_APP_URL link)
COA_API_BASE=
COA_API_KEY=
REWARDS_API_BASE=
REWARDS_API_KEY=
REWARDS_SYNC_ENABLED=
REWARDS_APP_URL=https://rewards.dimeindustries.com
ASSISTANT_API_BASE=
ASSISTANT_API_KEY=

# Emergency only: allow cookie demo auth when Supabase is unset in production.
# Leave unset/false for dimeindustries.us. Local/dev allows demo automatically.
ALLOW_DEMO_AUTH=

# =============================================================================
# CI / DEPLOY-ONLY — these live in GitHub Actions secrets, never in a local
# .env file. Listed here for reference only.
# =============================================================================
# STAGING_DATABASE_URL          (GitHub secret, staging environment)
# PRODUCTION_DATABASE_URL       (GitHub secret, production environment)
# VERCEL_STAGING_TOKEN          (GitHub secret, staging environment)
# VERCEL_PRODUCTION_TOKEN       (GitHub secret, production environment)
