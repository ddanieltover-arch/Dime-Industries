{
  "name": "dime-enterprise-commerce",
  "private": true,
  "version": "0.1.0",
  "description": "DIME Enterprise Commerce Platform — consolidated from Claude DevOS Enterprise phases (SRS through DevOps). See docs/ for the full build history.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke-production.mjs",
    "cutover:verify": "node scripts/verify-domain-cutover.mjs",
    "cutover:verify:once": "node scripts/verify-domain-cutover.mjs --once",
    "load:checkout": "node scripts/load-checkout-reserve.mjs",
    "load:checkout:probe": "node scripts/load-checkout-reserve.mjs --probe",
    "db:seed": "tsx db/seed.ts",
    "catalog:import": "node scripts/import-brand-catalog.mjs",
    "catalog:prices": "node scripts/apply-reference-prices.mjs",
    "catalog:seed-db": "tsx db/seed-brand-catalog.ts",
    "catalog:sync-images": "node scripts/sync-catalog-images.mjs",
    "catalog:refresh-images": "node scripts/refresh-catalog-images.mjs",
    "images:optimize": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.0",
    "@sentry/core": "8.55.2",
    "@sentry/nextjs": "^8.35.0",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "drizzle-orm": "^0.33.0",
    "framer-motion": "^11.5.0",
    "next": "^15.5.22",
    "next-themes": "^0.3.0",
    "postgres": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.24.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "jsdom": "^25.0.0",
    "postcss": "^8.5.22",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
